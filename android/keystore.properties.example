# Release signing. Copy this file to "keystore.properties" (in this android/ folder) and fill in
# the real values. keystore.properties and the keystore itself are gitignored and must never be
# committed. Back the keystore up somewhere safe outside the repo: every update has to be signed
# with the same key, or it won't install over an earlier version.
#
# storeFile: a full path (best: a folder outside the repo, forward slashes), or relative to
# this android/ folder.
storeFile=C:/keys/snp-release-key.jks
storePassword=REPLACE_ME
keyAlias=snp
keyPassword=REPLACE_ME
