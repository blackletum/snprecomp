# Copy to local.properties (in this android/ folder; never committed). Android Studio writes
# sdk.dir itself when it opens the project. Forward slashes, also on Windows.
sdk.dir=C:/Users/<you>/AppData/Local/Android/Sdk

# The desktop checkout's build folder, for its file_to_c (android/README.md).
snp.hostToolsDir=C:/dev/snprecomp/build

# Testing aid: pack Khronos' Vulkan validation layer into debug builds (android/README.md).
#snp.vulkanValidation=true
