diff --git a/recompinput/src/input_events.cpp b/recompinput/src/input_events.cpp
index 92087e0..f89a0de 100644
--- a/recompinput/src/input_events.cpp
+++ b/recompinput/src/input_events.cpp
@@ -224,6 +224,17 @@ bool sdl_event_filter(void* userdata, SDL_Event* event) {
         }
         queue_if_enabled(event);
         break;
+    case SDL_EventType::SDL_MOUSEBUTTONDOWN:
+        // A mouse button can be bound like a key.
+        if (binding::is_binding() && binding::get_scanning_device() == InputDevice::Keyboard) {
+            binding::set_scanned_input({ InputType::Mouse, event->button.button });
+            break;
+        }
+        if (!recompinput::game_input_disabled()) {
+            recompinput::add_mouse_click(event->button.button);
+        }
+        queue_if_enabled(event);
+        break;
     case SDL_EventType::SDL_DROPBEGIN:
         DropState.files_dropped.clear();
         break;
