diff --git a/recompui/src/util/file.cpp b/recompui/src/util/file.cpp
index 7ee84ed..140adca 100644
--- a/recompui/src/util/file.cpp
+++ b/recompui/src/util/file.cpp
@@ -120,7 +120,28 @@ namespace recompui {
 #elif defined(__linux__) && defined(RECOMP_FLATPAK)
         return "/app/bin";
 #else
-        return "";
+        // The folder with assets/ in it: the working folder (the default), else
+        // the exe's folder or the one above it (a build folder in the source
+        // tree), so the exe also starts from Explorer or a shortcut.
+        static const std::filesystem::path program_path = []() -> std::filesystem::path {
+            std::error_code ec;
+            if (std::filesystem::is_directory("assets", ec)) {
+                return "";
+            }
+            char* base = SDL_GetBasePath();
+            if (base == nullptr) {
+                return "";
+            }
+            std::filesystem::path exe_dir = std::filesystem::u8path(base);
+            SDL_free(base);
+            for (const std::filesystem::path& dir : { exe_dir, exe_dir.parent_path().parent_path() }) {
+                if (std::filesystem::is_directory(dir / "assets", ec)) {
+                    return dir;
+                }
+            }
+            return "";
+        }();
+        return program_path;
 #endif
     }
 
