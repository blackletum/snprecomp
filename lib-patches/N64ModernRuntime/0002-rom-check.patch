From: snprecomp
Subject: Let a game accept ROMs whose hash differs, through its own check

Other dumps and patches of a game (translations that only move data) run the
same code; the game can register a check that accepts them.

diff --git a/librecomp/include/librecomp/game.hpp b/librecomp/include/librecomp/game.hpp
index a4cf7e8..03ac9da 100644
--- a/librecomp/include/librecomp/game.hpp
+++ b/librecomp/include/librecomp/game.hpp
@@ -88,6 +88,11 @@ namespace recomp {
     bool register_game(const recomp::GameEntry& entry);
     void check_all_stored_roms();
     bool load_stored_rom(const std::u8string& game_id);
+    // A game's own check for ROMs whose hash doesn't match its entry (other dumps or
+    // patches of the same game): returns true to accept the ROM, already in big-endian
+    // byte order, for that entry.
+    using RomCheck = bool (*)(const GameEntry& game, const std::vector<uint8_t>& rom_data);
+    void set_rom_check(RomCheck check);
     RomValidationError select_rom(const std::filesystem::path& rom_path, const std::u8string& game_id);
     bool is_rom_valid(const std::u8string& game_id);
     bool is_rom_loaded();
diff --git a/librecomp/src/recomp.cpp b/librecomp/src/recomp.cpp
index ca35802..e6dd22b 100644
--- a/librecomp/src/recomp.cpp
+++ b/librecomp/src/recomp.cpp
@@ -166,6 +166,17 @@ bool check_hash(const std::vector<uint8_t>& rom_data, uint64_t expected_hash) {
     return calculated_hash == expected_hash;
 }
 
+static recomp::RomCheck rom_check = nullptr;
+
+void recomp::set_rom_check(RomCheck check) {
+    rom_check = check;
+}
+
+// The entry's hash, or the game's own check.
+static bool rom_matches(const recomp::GameEntry& game_entry, const std::vector<uint8_t>& rom_data) {
+    return check_hash(rom_data, game_entry.rom_hash) || (rom_check != nullptr && rom_check(game_entry, rom_data));
+}
