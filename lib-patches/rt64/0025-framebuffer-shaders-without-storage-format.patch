+    // A copy of SPIR-V with the format of its R32ui storage images and texel buffers left unknown, which
+    // the device allows (plume enables every feature it has, writing storage images without a format too).
+    static std::vector<uint32_t> spirvWithoutUintStorageFormat(const void *spirv, uint64_t spirvSize) {
+        const uint32_t OpCapability = 17;
+        const uint32_t OpTypeImage = 25;
+        const uint32_t ImageFormatUnknown = 0;
+        const uint32_t ImageFormatR32ui = 33;
+        const uint32_t CapabilityStorageImageReadWithoutFormat = 55;
+        const uint32_t CapabilityStorageImageWriteWithoutFormat = 56;
+        const size_t headerWords = 5;
+        std::vector<uint32_t> words(spirvSize / sizeof(uint32_t));
+        memcpy(words.data(), spirv, words.size() * sizeof(uint32_t));
+        for (size_t i = headerWords; i < words.size();) {
+            const uint32_t opcode = words[i] & 0xFFFFU;
+            const uint32_t wordCount = words[i] >> 16U;
+            if ((wordCount == 0) || ((i + wordCount) > words.size())) {
+                break;
+            }
+
+            // OpTypeImage: result, sampled type, dim, depth, arrayed, multisampled, sampled (2: storage), format.
+            if ((opcode == OpTypeImage) && (wordCount >= 9) && (words[i + 7] == 2) && (words[i + 8] == ImageFormatR32ui)) {
+                words[i + 8] = ImageFormatUnknown;
+            }
+
+            i += wordCount;
+        }
+
+        // Capabilities come first, right after the header.
+        const uint32_t capabilities[] = {
+            (2U << 16U) | OpCapability, CapabilityStorageImageWriteWithoutFormat,
+            (2U << 16U) | OpCapability, CapabilityStorageImageReadWithoutFormat
+        };
+
+        words.insert(words.begin() + headerWords, std::begin(capabilities), std::end(capabilities));
+        return words;
+    }
+
+    // Some drivers fail to compile the framebuffer shaders that write R32ui storage resources (Adreno 750,
+    // driver 512.762). Vulkan only: if the pipeline failed, try the shader again with their format unknown.
+    static void retryWithoutUintStorageFormat(RenderDevice *device, RenderShaderFormat shaderFormat, const char *name, ShaderRecord &record, const void *spirv, uint64_t spirvSize) {
+        if ((shaderFormat != RenderShaderFormat::SPIRV) || ((record.pipeline != nullptr) && record.pipeline->isValid())) {
+            return;
+        }
+
+        const std::vector<uint32_t> words = spirvWithoutUintStorageFormat(spirv, spirvSize);
+        std::unique_ptr<RenderShader> shader = device->createShader(words.data(), words.size() * sizeof(uint32_t), "CSMain", shaderFormat);
+        record.pipeline = device->createComputePipeline(RenderComputePipelineDesc(record.pipelineLayout.get(), shader.get(), 8, 8, 1));
+        const bool valid = (record.pipeline != nullptr) && record.pipeline->isValid();
+        fprintf(stderr, "[RT64] The %s pipeline %s without a storage format.\n", name, valid ? "compiled" : "also failed to compile");
+    }
