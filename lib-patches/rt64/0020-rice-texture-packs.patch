index 0000000..e497092
--- /dev/null
+++ b/src/common/rt64_rice_hash.h
@@ -0,0 +1,199 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+#include "common/rt64_load_types.h"
+#include "shared/rt64_f3d_defines.h"
+
+namespace RT64 {
+    // The key Rice Video names a hi-res texture by ("crc#fmt#siz" plus "#paletteCrc" for color-indexed
+    // textures, lowercase), computed from RDRAM the way Rice did. Adapted from tools/texture_hasher, which
+    // references GlideN64 and RiceVideo (GPL).
+    namespace RiceHash {
+        inline uint32_t calculateDXT(uint32_t txl2words) {
+            return (txl2words == 0) ? 1U : (2048 + txl2words - 1) / txl2words;
+        }
+
+        inline uint32_t txl2Words(uint32_t width, uint32_t size) {
+            static const uint32_t sizeBytes[4] = { 0, 1, 2, 4 };
+            return (size == 0) ? std::max(1U, width / 16) : std::max(1U, width * sizeBytes[size] / 8);
+        }
+
+        inline int reverseDXT(uint32_t val, uint32_t width, uint32_t size) {
+            if (val == 0x800) {
+                return 1;
+            }
+
+            int low = 2047 / val;
+            if (calculateDXT(low) > val) {
+                low++;
+            }
+
+            int high = 2047 / (val - 1);
+            if (low == high) {
+                return low;
+            }
+
+            for (int i = low; i <= high; i++) {
+                if (txl2Words(width, size) == uint32_t(i)) {
+                    return i;
+                }
+            }
+
+            return (low + high) / 2;
+        }
+
+        // RDRAM is stored in 32-bit words, as in the emulators Rice ran in.
+        inline uint32_t crc32(const uint8_t *src, int width, int height, int size, int rowStride) {
+            uint32_t crc = 0;
+            const int bytesPerLine = width << size >> 1;
+            for (int y = height - 1; y >= 0; y--) {
+                uint32_t esi = 0;
+                for (int x = bytesPerLine - 4; x >= 0; x -= 4) {
+                    esi = *reinterpret_cast<const uint32_t *>(src + x);
+                    esi ^= x;
+                    crc = (crc << 4) + ((crc >> 28) & 15);
+                    crc += esi;
+                }
+
+                esi ^= y;
+                crc += esi;
+                src += rowStride;
+            }
+
+            return crc;
+        }
+
+        inline uint8_t maxCI8(const uint8_t *src, uint32_t width, uint32_t height, uint32_t rowStride) {
+            uint8_t val = 0;
+            for (uint32_t y = 0; y < height; y++) {
+                const uint8_t *row = src + rowStride * y;
+                for (uint32_t x = 0; x < width; x++) {
+                    val = std::max(val, row[x]);
+                    if (val == 0xFF) {
+                        return val;
+                    }
+                }
+            }
+
+            return val;
+        }
+
+        inline uint8_t maxCI4(const uint8_t *src, uint32_t width, uint32_t height, uint32_t rowStride) {
+            uint8_t val = 0;
+            width >>= 1;
+            for (uint32_t y = 0; y < height; y++) {
+                const uint8_t *row = src + rowStride * y;
+                for (uint32_t x = 0; x < width; x++) {
+                    val = std::max(val, uint8_t(std::max(row[x] >> 4, row[x] & 0xF)));
+                    if (val == 0xF) {
+                        return val;
+                    }
+                }
+            }
+
+            return val;
+        }
+
+        // drawTile: the tile drawn with; loadOp: the last load into its TMEM address; palettes: TMEM's
+        // palettes as Rice kept them. False if it can't be computed.
+        inline bool key(const uint8_t *RDRAM, uint32_t rdramSize, const LoadTile &drawTile, uint32_t tlut, const LoadOperation &loadOp, const uint16_t (&palettes)[512], std::string &result) {
+            int bpl;
+            int width, height;
+            uint32_t rdramStart = loadOp.texture.address;
+            const uint32_t commonBytesOffset = (loadOp.tile.uls >> 2) << loadOp.texture.siz >> 1;
+            const uint32_t commonBytesPerRow = loadOp.texture.width << loadOp.texture.siz >> 1;
+            if (loadOp.type == LoadOperation::Type::Tile) {
+                uint16_t tileWidth = (std::max((loadOp.tile.lrs >> 2) - (loadOp.tile.uls >> 2), 0) + 1) & 0x03FF;
+                uint16_t tileHeight = (std::max((loadOp.tile.lrt >> 2) - (loadOp.tile.ult >> 2), 0) + 1) & 0x03FF;
+                tileWidth = (loadOp.tile.masks != 0) ? std::min(tileWidth, uint16_t(1U << loadOp.tile.masks)) : tileWidth;
+                bpl = loadOp.texture.width << loadOp.texture.siz >> 1;
+                width = std::min(tileWidth, loadOp.texture.width);
+                if (loadOp.tile.siz > drawTile.siz) {
+                    width <<= loadOp.tile.siz - drawTile.siz;
+                }
+
+                height = (loadOp.tile.maskt != 0) ? std::min(tileHeight, uint16_t(1U << loadOp.tile.maskt)) : tileHeight;
+                rdramStart = loadOp.texture.address + commonBytesOffset + commonBytesPerRow * (loadOp.tile.ult >> 2);
+            }
+            else if (loadOp.type == LoadOperation::Type::Block) {
+                const int tileWidth = std::max((drawTile.lrs >> 2) - (drawTile.uls >> 2), 0) + 1;
+                const int tileHeight = std::max((drawTile.lrt >> 2) - (drawTile.ult >> 2), 0) + 1;
+                const int maskWidth = (drawTile.masks == 0) ? tileWidth : (1 << drawTile.masks);
+                const int maskHeight = (drawTile.maskt == 0) ? tileHeight : (1 << drawTile.maskt);
+                const bool clamps = (drawTile.masks == 0) || (drawTile.cms & G_TX_CLAMP);
+                const bool clampt = (drawTile.maskt == 0) || (drawTile.cmt & G_TX_CLAMP);
+                width = (clamps && (tileWidth <= 256)) ? std::min(maskWidth, tileWidth) : maskWidth;
+                height = ((clampt && (tileHeight <= 256)) || (maskHeight > 256)) ? std::min(maskHeight, tileHeight) : maskHeight;
+                if (drawTile.siz == G_IM_SIZ_32b) {
+                    bpl = drawTile.line << 4;
+                }
+                else if (loadOp.tile.lrt == 0) {
+                    bpl = drawTile.line << 3;
+                }
+                else {
+                    uint32_t dxt = loadOp.tile.lrt;
+                    if (dxt > 1) {
+                        dxt = reverseDXT(dxt, loadOp.texture.width, loadOp.texture.siz);
+                    }
+
+                    bpl = dxt << 3;
+                }
+
+                rdramStart = loadOp.texture.address + commonBytesOffset + commonBytesPerRow * loadOp.tile.ult;
+            }
+            else {
+                return false;
+            }
+
+            if ((width <= 0) || (height <= 0) || (bpl <= 0)) {
+                return false;
+            }
+
+            // Rice hashes at least this many bytes, even past the texture.
+            const uint64_t expectedSize = uint64_t(height - 1) * bpl + (width << drawTile.siz >> 1);
+            if ((rdramStart & 3) || (uint64_t(rdramStart) + expectedSize > rdramSize)) {
+                return false;
+            }
+
+            const uint8_t *src = RDRAM + rdramStart;
+            const uint32_t crc = crc32(src, width, height, drawTile.siz, bpl);
+            char buffer[64];
+            snprintf(buffer, sizeof(buffer), "%08x#%u#%u", crc, uint32_t(drawTile.fmt), uint32_t(drawTile.siz));
+            result = buffer;
+
+            if (tlut > 0) {
+                const bool ci4 = (drawTile.siz == G_IM_SIZ_4b);
+                const uint8_t cimax = ci4 ? maxCI4(src, width, height, bpl) : maxCI8(src, width, height, bpl);
+                // Rice found a 4-bit texture's palette 32 entries apart, not 16; packs are named by that.
+                const uint16_t *palette = ci4 ? &palettes[(drawTile.palette & 0xF) << 5] : palettes;
+                const uint32_t paletteCrc = crc32(reinterpret_cast<const uint8_t *>(palette), cimax + 1, 1, 2, ci4 ? 32 : 512);
+                snprintf(buffer, sizeof(buffer), "#%08x", paletteCrc);
+                result += buffer;
+            }
+
+            return true;
+        }
+
+        // The key in a Rice file name: between the first '#' and the last '_', lowercase
+        // ("GAME#CRC#FMT#SIZ#PALCRC_ciByRGBA.png").
+        inline bool keyFromFileName(const std::string &fileName, std::string &result) {
+            const size_t firstHash = fileName.find_first_of('#');
+            const size_t lastUnderscore = fileName.find_last_of('_');
+            if ((firstHash == std::string::npos) || (lastUnderscore == std::string::npos) || (lastUnderscore <= firstHash)) {
+                return false;
+            }
+
+            result = fileName.substr(firstHash + 1, lastUnderscore - firstHash - 1);
+            std::transform(result.begin(), result.end(), result.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+            return true;
+        }
+    };
+};
