diff --git a/src/render/rt64_live_offset.h b/src/render/rt64_live_offset.h
new file mode 100644
index 0000000..785da0f
--- /dev/null
+++ b/src/render/rt64_live_offset.h
@@ -0,0 +1,23 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <cstdint>
+
+namespace RT64 {
+    // Matrix groups whose ID has this top byte are moved on every displayed
+    // frame by an offset the game supplies (the reticle following the latest
+    // input between the game's frames). Their world transforms' translation
+    // gets (dx, dy) added, in the model space's own units.
+    constexpr uint32_t LiveOffsetIdMask = 0xFF000000u;
+    constexpr uint32_t LiveOffsetIdTag = 0x5E000000u;
+
+    // Called from the renderer's thread for each such ID, once per displayed
+    // frame; returns false to leave it where the game drew it.
+    typedef bool (*LiveOffsetCallback)(uint32_t id, float *dx, float *dy);
+
+    void setLiveOffsetCallback(LiveOffsetCallback callback);
+    LiveOffsetCallback getLiveOffsetCallback();
+};
