     void TransformProcessor::process(const ProcessParams &p) {
+        // This frame's live offsets, asked for once per ID.
+        const LiveOffsetCallback liveCallback = getLiveOffsetCallback();
+        std::unordered_map<uint32_t, hlslpp::float2> liveOffsets;
+        auto applyLiveOffset = [&](const DrawData &drawData, size_t t, hlslpp::float4x4 &matrix) {
+            if ((liveCallback == nullptr) || (t >= drawData.worldTransformGroups.size())) {
+                return;
+            }
+            const uint32_t groupIndex = drawData.worldTransformGroups[t];
+            if (groupIndex >= drawData.transformGroups.size()) {
+                return;
+            }
+            const uint32_t id = drawData.transformGroups[groupIndex].matrixId;
+            if ((id & LiveOffsetIdMask) != LiveOffsetIdTag) {
+                return;
+            }
+            auto it = liveOffsets.find(id);
+            if (it == liveOffsets.end()) {
+                float dx = 0.0f, dy = 0.0f;
+                if (!liveCallback(id, &dx, &dy)) {
+                    dx = dy = 0.0f;
+                }
+                it = liveOffsets.emplace(id, hlslpp::float2(dx, dy)).first;
+            }
+            matrix[3][0] += it->second.x;
+            matrix[3][1] += it->second.y;
+        };
+
         for (uint32_t w : p.curFrame->workloads) {
             Workload &workload = p.workloadQueue->workloads[w];
             DrawData &drawData = workload.drawData;
