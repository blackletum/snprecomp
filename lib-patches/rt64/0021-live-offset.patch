 namespace RT64 {
+    // Live offsets
+
+    static std::atomic<LiveOffsetCallback> liveOffsetCallback{ nullptr };
+
+    void setLiveOffsetCallback(LiveOffsetCallback callback) {
+        liveOffsetCallback.store(callback);
+    }
+
+    LiveOffsetCallback getLiveOffsetCallback() {
+        return liveOffsetCallback.load();
+    }
