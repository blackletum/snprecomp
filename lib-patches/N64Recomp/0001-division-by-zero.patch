From: snprecomp
Subject: Give the VR4300's results for division by zero instead of a host exception

DIV/DIVU by zero on the N64 doesn't trap: the quotient is -1 (1 for a
negative signed dividend) and the remainder is the dividend. Sin and
Punishment has 1111 divisions without zero checks, and divides by zero when
starting a game. (snprecomp STATUS.md round 3)

diff --git a/include/recomp.h b/include/recomp.h
index 73f3e73..0396207 100644
--- a/include/recomp.h
+++ b/include/recomp.h
@@ -70,17 +70,52 @@ static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64
 #error "128-bit integer type not found"
 #endif
 
+// Division by zero doesn't trap on the VR4300; it gives these results (the
+// quotient is -1, or 1 for a negative signed dividend, and the remainder is
+// the dividend). Code compiled without zero-division checks relies on that.
 static inline void DDIV(int64_t a, int64_t b, int64_t* quot, int64_t* rem) {
+    if (b == 0) {
+        *quot = a < 0 ? 1 : -1;
+        *rem = a;
+        return;
+    }
     int overflow = ((uint64_t)a == 0x8000000000000000ull) && (b == -1ll);
     *quot = overflow ? a : (a / b);
     *rem = overflow ? 0 : (a % b);
 }
 
 static inline void DDIVU(uint64_t a, uint64_t b, uint64_t* quot, uint64_t* rem) {
+    if (b == 0) {
+        *quot = UINT64_MAX;
+        *rem = a;
+        return;
+    }
     *quot = a / b;
     *rem = a % b;
 }
 
+// 32-bit DIV/DIVU: lo and hi get the sign-extended 32-bit results.
+static inline void DIV32(int32_t a, int32_t b, uint64_t* lo, uint64_t* hi) {
+    if (b == 0) {
+        *lo = (uint64_t)(int64_t)(a < 0 ? 1 : -1);
+        *hi = (uint64_t)(int64_t)a;
+        return;
+    }
+    // In 64 bits so that 0x80000000 / -1 doesn't trap either: it gives 0x80000000 and 0.
+    *lo = (uint64_t)(int64_t)(int32_t)((int64_t)a / (int64_t)b);
+    *hi = (uint64_t)(int64_t)(int32_t)((int64_t)a % (int64_t)b);
+}
+
+static inline void DIVU32(uint32_t a, uint32_t b, uint64_t* lo, uint64_t* hi) {
+    if (b == 0) {
+        *lo = UINT64_MAX;
+        *hi = (uint64_t)(int64_t)(int32_t)a;
+        return;
+    }
+    *lo = (uint64_t)(int64_t)(int32_t)(a / b);
+    *hi = (uint64_t)(int64_t)(int32_t)(a % b);
+}
+
 typedef uint64_t gpr;
 
 #define SIGNED(val) \
